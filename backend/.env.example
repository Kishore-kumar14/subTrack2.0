# Server Port (assigned automatically by cloud hosts like Render/Railway/Heroku via process.env.PORT)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.jjdqt3u.mongodb.net/subtrack?retryWrites=true&w=majority

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=122009448904-efj5bl9mp9926bdh8mg6em2hmj02up3o.apps.googleusercontent.com

# Frontend App URL (Used for links inside confirmation emails, e.g. https://your-subtrack.vercel.app)
FRONTEND_URL=https://your-subtrack.vercel.app

# Option A: Transactional Email API via Resend (RECOMMENDED for Render & cloud hosts)
# Note: Render free tier blocks outbound SMTP ports (587, 465).
# Resend runs over standard HTTPS (port 443) and is 100% free (3,000 emails/mo) at https://resend.com
# RESEND_API_KEY=re_123456789

# Option B: Standard SMTP (Gmail App Password or Custom SMTP)
# Requires 16-character Google App Password (not your normal Google password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="SubTrack App" <your_email@gmail.com>

# Security Secrets
ADMIN_API_KEY=subtrack_adm_sec_9e2f4a18c67d3b5e
JWT_SECRET=subtrack_jwt_sec_8a3d5e7f2b1c4e90d1f8a7e3