# Server Port (assigned automatically by cloud hosts like Render/Railway/Heroku via process.env.PORT)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.jjdqt3u.mongodb.net/subtrack?retryWrites=true&w=majority

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=122009448904-efj5bl9mp9926bdh8mg6em2hmj02up3o.apps.googleusercontent.com

# SMTP Email Configuration (Gmail App Password or SendGrid / Resend)
